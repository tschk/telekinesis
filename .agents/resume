#!/usr/bin/env bash
# Fast reconnect for telekinesis orbs. No installs.
set -euo pipefail

if [ -f "$HOME/.cargo/env" ]; then
  # shellcheck disable=SC1091
  . "$HOME/.cargo/env"
fi

if ! command -v rustc >/dev/null 2>&1 || ! command -v cargo >/dev/null 2>&1; then
  printf 'resume: rustc/cargo missing; run .agents/setup\n' >&2
  exit 1
fi

div #root w-full h-full flex flex-row bg-zinc-950 text-zinc-200 overflow-hidden
  div #sessions w-44 h-full flex flex-col border-r border-zinc-800 shrink-0
    div h-11 w-full flex flex-row items-center px-3 gap-2 border-b border-zinc-800 shrink-0
      button w-2.5 h-2.5 rounded-full bg-zinc-600 hover:bg-zinc-400 @click=close_window
      button w-2.5 h-2.5 rounded-full bg-zinc-700 hover:bg-zinc-500 @click=minimize_window
      button w-2.5 h-2.5 rounded-full bg-zinc-500 hover:bg-zinc-300 @click=maximize_window
      span text-xs text-zinc-500
        "tk"
    div flex-1 w-full px-2 py-2 flex flex-col gap-1 overflow-y-scroll
      for session in {sessions}
        if {session.is_computer}
          if {session.active}
            button w-full px-2 py-1.5 rounded-md bg-zinc-900 border border-zinc-700 @click=use_computer
              span text-xs text-zinc-100
                "{session.name}"
          else
            button w-full px-2 py-1.5 rounded-md hover:bg-zinc-900 @click=use_computer
              span text-xs text-zinc-500
                "{session.name}"
        else
          if {session.active}
            button w-full px-2 py-1.5 rounded-md bg-zinc-900 border border-zinc-700 @click=use_coding
              span text-xs text-zinc-100
                "{session.name}"
          else
            button w-full px-2 py-1.5 rounded-md hover:bg-zinc-900 @click=use_coding
              span text-xs text-zinc-500
                "{session.name}"
    div w-full px-2 pb-3 pt-1 flex flex-col gap-1 shrink-0
      button w-full px-2 py-1 rounded-full border border-zinc-800 bg-zinc-900 @click=cycle_effort
        span text-xs text-zinc-400 font-mono
          "{model} · {effort}"
      span text-xs text-zinc-600 font-mono
        "{context_pct}%"
  div #main flex-1 h-full flex flex-col overflow-hidden
    div #status h-11 w-full flex flex-row items-center px-4 border-b border-zinc-800 gap-2 shrink-0
      div w-1.5 h-1.5 rounded-full
        if {connected}
          if {busy}
            bg-zinc-400
          else
            bg-zinc-200
        else
          bg-zinc-700
      span text-xs text-zinc-500 font-mono
        "{status}"
      span text-xs text-zinc-700
        "·"
      span text-xs text-zinc-600 font-mono
        "{provider}"
      span flex-1
      if {has_queue}
        span text-xs text-zinc-500 font-mono
          "queue {queued}"
    div #timeline flex-1 w-full overflow-y-scroll
      div w-full max-w-180 mx-auto px-6 py-6 flex flex-col gap-3
        for message in {messages}
          div w-full flex flex-col
            if {message.is_tool}
              span text-xs text-zinc-600 font-mono whitespace-pre-wrap
                "{message.role}  {message.content}"
            else
              if {message.is_user}
                span text-sm text-zinc-400 whitespace-pre-wrap
                  "{message.content}"
              else
                if {message.is_error}
                  span text-sm text-red-400 whitespace-pre-wrap
                    "{message.content}"
                else
                  span text-sm text-zinc-200 whitespace-pre-wrap
                    "{message.content}"
    div #composer w-full shrink-0 flex flex-col px-4 pb-4 pt-2
      div w-full max-w-180 mx-auto min-h-14 rounded-xl bg-zinc-900 border border-zinc-800 flex flex-col
        div min-h-8 max-h-24 w-full px-3 pt-2 text-sm text-zinc-100 font-mono whitespace-pre-wrap overflow-y-scroll
          "{input}"
        div h-6 w-full flex flex-row items-center px-3
          span text-xs text-zinc-600 font-mono
            if {connected}
              "enter send · shift+enter newline · ⌘v paste · /effort"
            else
              "run `tk login openai` or /login"
          span flex-1
          if {busy}
            button text-zinc-400 hover:text-zinc-100 text-xs font-mono @click=interrupt
              "stop"
          else
            span
          if {connected}
            if {busy}
              button text-zinc-300 hover:text-zinc-100 text-xs font-mono @click=send_prompt
                "queue ↵"
            else
              button text-zinc-200 hover:text-zinc-50 text-xs font-mono @click=send_prompt
                "send ↵"
          else
            if {login_busy}
              span text-xs text-zinc-400 font-mono
                "logging in"
            else
              button text-zinc-200 hover:text-zinc-50 text-xs font-mono @click=start_login
                "login"

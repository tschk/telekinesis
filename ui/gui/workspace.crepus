div #workspace w-full h-full flex flex-col bg-[#1c1c1e] text-[#ededf0] overflow-hidden when:{light}="bg-[#f3f3f5] text-[#242426]"
  div #workspace-body flex-1 min-h-0 w-full flex flex-row
    if {sidebar_visible}
      div #sidebar w-[248px] h-full flex flex-col shrink-0 border-r border-[#303033] when:{light}="border-[#dedee2]"
        div h-12 px-4 flex flex-row items-center gap-2
          span flex-1 text-sm font-semibold
            "Telekinesis"
          button text-lg text-[#a7a7ad] px-2 py-1 rounded-md hover:bg-[#77777722] @click=new_thread when:{light}="text-[#64646b]"
            "+"
        div #search-box mx-3 mb-3 rounded-md bg-[#252527] px-2 py-1 when:{light}="bg-[#e9e9ed]"
          {search_input}
        {coordinator_item}
        div #thread-list w-full flex-1 min-h-0 flex flex-col overflow-y-scroll
          {thread_items}
        button px-4 py-3 text-left text-xs text-[#96969e] hover:bg-[#77777722] @click=open_project when:{light}="text-[#64646b]"
          "+ Open project…"
        if {can_retry_settlement}
          button text-xs text-[#bca6ff] p-4 @click=retry_settlement when:{light}="text-[#7151af]"
            "Retry cleanup inspection"
    div #conversation flex-1 min-w-0 h-full flex flex-col bg-[#202022] overflow-hidden when:{light}="bg-[#ffffff]"
      div h-12 w-full flex flex-row items-center px-4 gap-4 border-b border-[#303033] shrink-0 when:{light}="border-[#e6e6e9]"
        div h-full min-w-0 px-3 flex items-center border-r border-[#303033] when:{light}="border-[#e6e6e9]"
          span truncate text-sm
            "{thread_title}"
        span flex-1
        button text-xs text-[#9e9ea7] px-2 py-1 rounded-md hover:bg-[#77777722] @click=toggle_settings when:{light}="text-[#6b6b73]"
          "Details"
      if {has_parent}
        button w-full text-left text-xs text-[#bca6ff] px-6 py-2 @click=original_thread when:{light}="text-[#7151af]"
          "← Original thread"
      if {has_error}
        div #error w-full px-6 py-3 bg-[#37252b] text-sm text-[#f4b9c8] when:{light}="bg-[#fff0f2] text-[#963449]"
          "{error_text}"
      div #history flex-1 min-h-0 w-full overflow-y-scroll
        div w-full max-w-[760px] mx-auto px-8 py-8 flex flex-col gap-8
          if {empty_history}
            div w-full py-8 flex flex-col gap-3
              span text-lg font-semibold
                "{empty_title}"
              span text-sm text-[#a2a2aa] when:{light}="text-[#6b6b73]"
                "{empty_detail}"
          for message in {messages}
            div w-full min-w-0 flex flex-col gap-3
              span text-xs font-semibold text-[#a2a2aa] when:{light}="text-[#6b6b73]"
                "{message.role}"
              span w-full min-w-0 text-base whitespace-normal
                "{message.content}"
          for receipt in {receipts}
            span text-xs text-[#a2a2aa] when:{light}="text-[#6b6b73]"
              "{receipt}"
      div w-full max-w-[760px] mx-auto px-8 pb-6 pt-3 shrink-0 flex flex-col gap-3
        if {has_attachment}
          div flex flex-row items-center gap-3
            span flex-1 text-xs text-[#bca6ff] when:{light}="text-[#7151af]"
              "Reference context attached"
            button text-xs text-[#a2a2aa] @click=remove_context when:{light}="text-[#6b6b73]"
              "Remove"
        if {handoff_open}
          div flex flex-row items-center gap-3
            span flex-1 text-xs text-[#bca6ff] when:{light}="text-[#7151af]"
              "{edit_label}"
            button text-xs text-[#a2a2aa] @click=cancel_handoff when:{light}="text-[#6b6b73]"
              "Cancel"
        if {can_send}
          div #composer-shell w-full rounded-lg bg-[#28282b] border border-[#414145] flex flex-col when:{light}="bg-[#fafafa] border-[#d7d7dd]"
            div #composer-scroll w-full max-h-48 overflow-y-scroll px-4 pt-3 pb-2
              {composer}
            div h-10 px-3 w-full flex flex-row items-center gap-3
              if {is_root}
                button text-xs text-[#a2a2aa] px-1 py-1 rounded-md hover:bg-[#77777722] @click=toggle_context when:{light}="text-[#6b6b73]"
                  "+ Attach context"
              span flex-1
              if {busy}
                if {is_root}
                  button text-xs text-[#a2a2aa] @click=toggle_queue when:{light}="text-[#6b6b73]"
                    "{send_mode}"
                button px-3 py-1 rounded-md bg-[#653c48] text-[#ffe6ec] text-xs @click=stop
                  "Stop"
              else
                button px-3 py-1 rounded-md bg-[#bca6ff] text-[#21182f] text-xs font-semibold @click=send_click
                  "{send_label}"
        if {show_status}
          span text-xs text-[#a2a2aa] when:{light}="text-[#6b6b73]"
            "{status}"
    if {inspector_visible}
      div #inspector w-80 h-full flex flex-col shrink-0 bg-[#1c1c1e] border-l border-[#303033] overflow-hidden when:{light}="bg-[#f8f8fa] border-[#e1e1e5]"
        div h-14 px-4 flex flex-row items-center gap-3 border-b border-[#303033] when:{light}="border-[#e1e1e5]"
          span flex-1 text-sm font-semibold
            "{inspector_title}"
          button text-xs text-[#9e9ea7] px-2 py-1 rounded-md hover:bg-[#77777722] @click=close_inspector when:{light}="text-[#6b6b73]"
            "Close"
        div #inspector-scroll flex-1 min-h-0 overflow-y-scroll p-4 flex flex-col gap-4
          if {show_settings}
            {settings}
          else
            {context_panel}

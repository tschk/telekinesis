div #root w-full h-full flex flex-col bg-zinc-950 text-zinc-200
  div #pair h-12 w-full flex flex-row items-center px-4 border-b border-zinc-800
    span text-xs text-zinc-500
      "pair"
    span flex-1
    span text-xs text-zinc-400 font-mono
      "{pair_url}"
  div #timeline flex-1 w-full px-4 py-3 flex flex-col gap-2
    for message in {messages}
      if {message.is_user}
        span text-sm text-zinc-400
          "{message.content}"
      else
        span text-sm text-zinc-200
          "{message.content}"
  div #composer w-full px-4 pb-4 flex flex-col gap-1
    span text-sm text-zinc-300 font-mono
      "{input}"
    span text-xs text-zinc-600 font-mono
      "{model} · {effort} · {composer_action}"

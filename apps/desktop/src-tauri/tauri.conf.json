{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Telekinesis Desktop",
  "version": "0.1.0",
  "identifier": "com.tschk.telekinesis.desktop",
  "build": {
    "beforeDevCommand": "python3 ../../scripts/stage-local-host.py tauri --helper-only --profile dev --out ../../target/tauri-helper && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "python3 ../../scripts/stage-local-host.py tauri --helper-only --profile release --out ../../target/tauri-helper && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Telekinesis ADE",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/rx4-script-worker"
    ]
  }
}
